            "Bu mavzu juda qiziq.",
            "Men sizga yordam berishga tayyorman."
        ]

        return f"{self.name}: {random.choice(answers)}"

    # ===============================
    # MATH SOLVER
    # ===============================

    def solve_math(self, exp):

        try:
            result = sympy.sympify(exp)
            return result
